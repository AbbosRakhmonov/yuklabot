# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/yuklabot

# Node Environment
NODE_ENV=development

# Bot Name
BOT_NAME=YuklaBot

# Log Level (error, warning, info, http, debug)
LOG_LEVEL=debug

# Timezone (e.g., America/New_York, Europe/London, Asia/Tokyo, UTC)
TZ=UTC

# Webhook Configuration
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_PATH=/webhook/your_bot_token_prefix
PORT=3000

# Telegram Local Bot API Configuration
# Set to true to use local Bot API, or provide custom API URL
TELEGRAM_LOCAL_MODE=false
TELEGRAM_API_URL=https://api.telegram.org

# YT-DLP Path
YTDLP_PATH=yt-dlp
# GALLERY-DL Path
GALLERY_DL_PATH=gallery-dl
# FFMPEG Path
FFMPEG_PATH=ffmpeg
# Optional, by default ffprobe next to FFMPEG_PATH
FFPROBE_PATH=

# Proxies for Instagram / TikTok / YouTube requests. Every request starts at
# the next proxy (round-robin); if it is blocked or dead the next one is
# tried, finally the server's own IP. Empty: everything goes direct.
# Comma or newline separated: http://user:pass@host:port, https://host:port,
# socks5://user:pass@host:port (residential/mobile proxies work best)
PROXY_LIST=
# Or a file with one proxy per line (# comments allowed)
PROXY_FILE=
# Proxies tried per request before the server IP
PROXY_MAX_ATTEMPTS=3
# A blocked/dead proxy is skipped for this many minutes
PROXY_COOLDOWN_MINUTES=10
# false: never use the server's own IP (only proxies)
PROXY_DIRECT_FALLBACK=true

# Instagram posts and reels are fetched WITHOUT cookies.
# Cookies (Netscape txt) are only used for stories, if set.
# Use a throwaway account, never your personal one.
INSTAGRAM_COOKIES_PATH=
# Without cookies (or if they fail) stories come from this third-party API
# (GET {base}/insta?url=<story link>). Only story links are sent to it.
# Empty: the default (JerryCoder); "false": stories need cookies
INSTAGRAM_STORY_API=
# Instagram's anonymous post GraphQL query ids, comma separated, tried in
# order (update if Instagram retires them)
INSTAGRAM_GQL_DOC_ID=25018359077785073,24368985919464652,8845758582119845
# Deprecated: added to the PROXY_LIST pool
TIKTOK_PROXY=
# yt-dlp browser
TIKTOK_IMPERSONATE=

# Max downloads/conversions (yt-dlp, gallery-dl, ffmpeg) at the same time
MAX_CONCURRENT_PROCESSES=3
# Max quick metadata lookups at the same time (separate from downloads)
MAX_CONCURRENT_INFO_PROCESSES=5

# A video over Telegram's limit (50 MB / 2 GB with local Bot API) is sent
# in parts (cut, never re-encoded); at most this many parts
MAX_VIDEO_PARTS=10

# Monitoring Dashboard Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# Admin Telegram Chat ID (to receive files via "Send to Me" button)
ADMIN_CHAT_ID=
ADMIN_SECRET=change_this_secret_token
